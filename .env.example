# These values must reach every gunicorn worker.
#
# A .env file is NOT loaded automatically — gunicorn and pm2 do not read one, and
# the app does not use python-dotenv. Put them in the pm2 ecosystem `env` block
# (see ecosystem.config.js) or export them before starting the process.
#
# Verify what each worker actually received:
#   for pid in $(pgrep -f "gunicorn: worker"); do
#     echo "== $pid"; tr '\0' '\n' < /proc/$pid/environ | grep -E "REDIS_URL|DATABASE_URL|SECRET_KEY"
#   done

# REQUIRED when running more than one worker.
# Without it, each worker delivers OTPs only to the WebSocket clients sharing its
# own process, and users land on random workers — so most receive nothing.
# Every worker must point at the SAME Redis instance and database index.
# The channel is fixed at "orbitalcore:otp".
REDIS_URL=redis://127.0.0.1:6379/0

# REQUIRED when running more than one worker, and must be identical everywhere,
# otherwise admin session cookies break when the browser hits a different worker.
SECRET_KEY=change-me-to-a-long-random-value

# The default is SQLite at device_auth.db. SQLite serialises writers, so concurrent
# workers raise "database is locked" under load (WAL + busy_timeout is enabled as a
# mitigation, not a fix). Switch to PostgreSQL for real multi-worker use:
#   pip install psycopg2-binary
#   DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/orbitalcore
DATABASE_URL=sqlite:///device_auth.db

# A global WebSocket token that bypasses per-user DeviceUser lookup. Leave unset
# to require a per-user token from POST /api/authenticate.
# WS_AUTH_TOKEN=

# OTP rows older than this many minutes are removed on each GET /api/messages/<phone>.
OTP_RETENTION_MINUTES=30

# Password for the default "incomplete" admin account, applied only when that
# account is first created.
# ADMIN_PASSWORD=

# gunicorn sizing — see gunicorn.conf.py
# BIND=0.0.0.0:8002
# WEB_CONCURRENCY=4
# WEB_THREADS=8
# WEB_TIMEOUT=120
# LOG_LEVEL=info
