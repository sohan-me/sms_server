# Copy to .env and adjust. Flask does not load .env automatically unless you use python-dotenv or similar.

# OTP rows older than this many minutes are removed on each GET /api/messages/<phone>. Default: 30.
OTP_RETENTION_MINUTES=30

# GET /api/messages/<phone> accepts optional query ?message_pub=IVAC|VFS (default IVAC). POST body may include "message_pub".
