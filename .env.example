# These values must reach every server process.
#
# A .env file is NOT loaded automatically — neither gunicorn, uvicorn nor pm2
# reads one, and neither app uses python-dotenv. Put them in the pm2 ecosystem
# `env` block instead:
#   ecosystem.config.js              (Flask,    port 8002)
#   fastapi_app/ecosystem.config.js  (FastAPI,  port 3002)
#
# Verify what each process actually received:
#   for pid in $(pgrep -f "gunicorn: worker"); do
#     echo "== $pid"; tr '\0' '\n' < /proc/$pid/environ | grep -E "REDIS_URL|DATABASE_URL|SECRET_KEY"
#   done

# REQUIRED when running more than one process.
# Without it, each process delivers OTPs only to the WebSocket clients it holds,
# so users landing on another process receive nothing. Every process must point at
# the SAME Redis instance and database index. The channel is fixed at "orbitalcore:otp".
REDIS_URL=redis://127.0.0.1:6379/0

# REQUIRED when running more than one process, and must be IDENTICAL across both
# services — otherwise admin session cookies break when the browser is routed to a
# different process, or after the Flask -> FastAPI cutover.
SECRET_KEY=change-me-to-a-long-random-value

# ── Database ───────────────────────────────────────────────────
# The Flask app defaults to SQLite. WAL and a busy timeout are enabled
# automatically, but SQLite still serialises writers, so concurrent workers can
# raise "database is locked". PostgreSQL is the supported target for the FastAPI
# service and recommended once the Flask app runs multiple workers:
#   pip install psycopg2-binary
#   DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/orbitalcore
#
# Tortoise (FastAPI) requires PostgreSQL or SQLite:
#   postgres://user:pass@127.0.0.1:5432/orbitalcore
DATABASE_URL=sqlite:///device_auth.db

# A global WebSocket token that bypasses per-user DeviceUser lookup. Leave unset
# to require a per-user token from POST /api/authenticate.
# WS_AUTH_TOKEN=

# OTP rows older than this many minutes are removed on each GET /api/messages/<phone>.
OTP_RETENTION_MINUTES=30

# Password for the default "incomplete" admin account, applied only when that
# account is first created.
# ADMIN_PASSWORD=

# ── Flask / gunicorn (port 8002) — see gunicorn.conf.py ───────
# BIND=0.0.0.0:8002
# WEB_CONCURRENCY=4
# WEB_THREADS=8
# WEB_TIMEOUT=120
# LOG_LEVEL=info

# ── FastAPI / uvicorn (port 3002) — see fastapi_app/main.py ────
# PORT=3002
# HOST=0.0.0.0